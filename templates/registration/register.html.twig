{% extends 'base.html.twig' %}
{% block body %}
<div class="body">
{{ parent() }}
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Bootstrap Bundle JS (inclut Popper.js) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<div class="flexrow">
    
        <div class="image-register-login"></div>

    
        <div class="registration-frame">
        
            <p>Inscription</p>
            

            {{ form_start(registrationForm, {'attr': {'class': 'form-horizontal'}}) }}

            <div class="form-group">
                {{ form_row(registrationForm.nom, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="form-group">
                {{ form_row(registrationForm.prenom, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="form-group">
                {{ form_row(registrationForm.telephone, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="form-group">
                {{ form_row(registrationForm.classe, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="form-group">
                {{ form_row(registrationForm.email, {'attr': {'class': 'form-control', 'type': 'email'}}) }}
            </div>

            <div class="form-group">
                {{ form_row(registrationForm.plainPassword, {'attr': {'class': 'form-control', 'type': 'password'}}) }}
                <div class="password-icon">
                    <i data-feather="eye"></i>
                    <i data-feather="eye-off"></i>
                </div>
            </div>

            <div class="form-group">
                {{ form_row(registrationForm.agreeTerms, {'attr': {'class': 'agreeterms','type': 'checkbox'}}) }}
            </div>

            <div class="form-group">
                <button type="submit" class="registerButton">Créer mon compte</button>
            </div>

            <div class="form-group">
                <a href="{{ path('app_login') }}">Vous avez déjà un compte ? Connectez-vous</a>
                <a href="{{ path('app_acceuil') }}">Continuer en tant qu'invité</a>
            </div>
            {{ form_end(registrationForm) }}
        </div>

</div>

<style>
 .body {
    background-color: #2D2D2D;
    }
@media (max-width: 768px) {
    /* Flexbox container */
    .flexrow {
        display: flex;
        flex-direction: column; /* Passe en colonne */
        width: 100%; /* Assure que le conteneur occupe toute la largeur */
        margin: 0; /* Retirer les marges externes */
        padding: 0; /* Retirer les padding externes */
    }

    /* Image section */
    .image-register-login {
        order: -1; /* Place l'image au-dessus */
        height: 200px; /* Ajustement pour mobile */
        display: block; /* Assure que l'élément reste visible */
        width: 100%; /* L'image occupe toute la largeur */
        object-fit: cover; /* L'image est redimensionnée en fonction du conteneur */
    }

    /* Formulaire */
    .registration-frame {
        order: 0; /* Formulaire en dessous */
        width: 100%; /* Le formulaire prend toute la largeur */
        padding: 20px; /* Un peu de marge intérieure pour un meilleur visuel */
        box-sizing: border-box; /* Inclut le padding dans la largeur */
        display: flex;
        flex-direction: column; /* Organise les éléments du formulaire en colonne */
    }

    /* Champs de formulaire */
    .form-control {
        width: 100%; /* Les champs de formulaire occupent toute la largeur */
        box-sizing: border-box; /* Inclut le padding et la bordure dans la largeur totale */
        margin-bottom: 10px; /* Espacement entre les champs */
        padding: 10px; /* Un peu d'espace à l'intérieur des champs */
        font-size: 16px; /* Taille du texte */
    }

    /* Bouton d'inscription */
    .registerButton {
        width: 100%; /* Le bouton prend toute la largeur */
        padding: 10px; /* Un peu d'espace pour rendre le bouton plus accessible */
        font-size: 16px; /* Ajustement de la taille du texte */
        cursor: pointer; /* Indiquer que c'est cliquable */
        box-sizing: border-box; /* Inclut le padding dans la largeur totale */
        margin-top: 10px; /* Un peu de marge au-dessus du bouton */
    }

    /* Lien sous le formulaire */
    a {
        display: block; /* Le lien prend toute la largeur disponible */
        text-align: center; /* Centrer le lien */
        margin-top: 10px; /* Un peu de marge au-dessus du lien */
        font-size: 14px; /* Taille du texte */
        color: #007BFF; /* Couleur bleue pour le lien */
        text-decoration: none; /* Supprimer la décoration par défaut */
    }
}
</style>


{% block footer %}
{{ parent() }}
{% endblock %}
{% endblock %}