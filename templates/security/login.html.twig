{% extends 'base.html.twig' %}

{% block body %}
<div class="body">
{{ parent() }}
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Bootstrap Bundle JS (inclut Popper.js) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<div class="body">

<form method="post">
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <div class="mb-3">
            Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Déconnexion</a>
        </div>
    {% endif %}

<div class="flexrow">
    <div class="image-register-login"></div>

    <div class="registration-frame">
        <p>Se Connecter</p>
        <label for="inputEmail">Email</label>
        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
        
        <br>
        <label for="inputPassword">Mot de Passe</label>
        <div class="password-wrapper">
            <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
            <div class="password-icon" onclick="togglePassword()">
                <i id="eye-icon" data-feather="eye"></i>
                <i id="eye-icon-off" data-feather="eye-off" style="display: none;"></i>
            </div>
        </div>
        
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <br>
        <button type="submit" class="registerButton">Se Connecter</button>
        <br>
        <a href="{{ path('app_register') }}">Pas encore de compte ? S'inscrire</a>
    </div>
</div>
</div>

<style>
 .body {
    background-color: #2D2D2D;
    }
@media (max-width: 768px) {
    /* Flexbox container */
    .flexrow {
        display: flex;
        flex-direction: column; /* Passe en colonne */
        width: 100%; /* Assure que le conteneur occupe toute la largeur */
        margin: 0; /* Retirer les marges externes */
        padding: 0; /* Retirer les padding externes */
    }

    /* Image section */
    .image-register-login {
        order: -1; /* Place l'image au-dessus */
        height: 200px; /* Ajustement pour mobile */
        display: block; /* Assure que l'élément reste visible */
        width: 100%; /* L'image occupe toute la largeur */
        object-fit: cover; /* L'image est redimensionnée en fonction du conteneur */
    }

    /* Formulaire */
    .registration-frame {
        order: 0; /* Formulaire en dessous */
        width: 100%; /* Le formulaire prend toute la largeur */
        padding: 20px; /* Un peu de marge intérieure pour un meilleur visuel */
        box-sizing: border-box; /* Inclut le padding dans la largeur */
        display: flex;
        flex-direction: column; /* Organise les éléments du formulaire en colonne */
    }

    /* Champs de formulaire */
    .form-control {
        width: 100%; /* Les champs de formulaire occupent toute la largeur */
        box-sizing: border-box; /* Inclut le padding et la bordure dans la largeur totale */
        margin-bottom: 10px; /* Espacement entre les champs */
        padding: 10px; /* Un peu d'espace à l'intérieur des champs */
        font-size: 16px; /* Taille du texte */
    }

    /* Bouton d'inscription */
    .registerButton {
        width: 100%; /* Le bouton prend toute la largeur */
        padding: 10px; /* Un peu d'espace pour rendre le bouton plus accessible */
        font-size: 16px; /* Ajustement de la taille du texte */
        cursor: pointer; /* Indiquer que c'est cliquable */
        box-sizing: border-box; /* Inclut le padding dans la largeur totale */
        margin-top: 10px; /* Un peu de marge au-dessus du bouton */
    }

    /* Lien sous le formulaire */
    a {
        display: block; /* Le lien prend toute la largeur disponible */
        text-align: center; /* Centrer le lien */
        margin-top: 10px; /* Un peu de marge au-dessus du lien */
        font-size: 14px; /* Taille du texte */
        color: #007BFF; /* Couleur bleue pour le lien */
        text-decoration: none; /* Supprimer la décoration par défaut */
    }
}

/* Conteneur du champ de mot de passe */
.password-wrapper {
    position: relative; /* Permet de positionner l'icône de manière absolue par rapport à ce conteneur */
    width: 100%; /* Le champ de mot de passe prend toute la largeur disponible */
}

/* Style du champ de saisie du mot de passe */
.password-wrapper .form-control {
    padding-right: 40px; /* Ajoute un espace à droite pour éviter que l'icône recouvre le texte */
}

/* Style de l'icône permettant d'afficher/cacher le mot de passe */
.password-icon {
    position: absolute; /* Positionne l'icône par rapport au conteneur parent (password-wrapper) */
    right: 10px; /* Place l'icône à 10px du bord droit du champ */
    top: 50%; /* Aligne l'icône verticalement au centre du champ */
    transform: translateY(-50%); /* Ajuste l'alignement vertical pour être bien centré */
    cursor: pointer; /* Change le curseur en pointeur pour indiquer que l'icône est cliquable */
    font-size: 20px; /* Définit la taille de l'icône */
    color: #888; /* Couleur de l'icône par défaut */
    z-index: 10; /* S'assure que l'icône reste au-dessus du champ */
}

/* Changement de couleur de l'icône au survol */
.password-icon:hover {
    color: #333; /* Fait ressortir l'icône lorsqu'on passe la souris dessus */
}
</style>

<!-- ICON SCRIPT -->
<script src="https://unpkg.com/feather-icons"></script>
<script>
feather.replace();

function togglePassword() {
    let passwordInput = document.querySelector("#inputPassword");
    let eyeIcon = document.querySelector("#eye-icon");
    let eyeIconOff = document.querySelector("#eye-icon-off");

    if (passwordInput.type === "password") {
        passwordInput.type = "text";
        eyeIcon.style.display = "none";
        eyeIconOff.style.display = "inline";
    } else {
        passwordInput.type = "password";
        eyeIcon.style.display = "inline";
        eyeIconOff.style.display = "none";
    }

    // Recharge les icônes Feather pour s'assurer qu'elles s'affichent bien
    feather.replace();
}
</script>

{% endblock %}